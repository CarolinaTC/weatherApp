{
  "name": "weatherreact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.18.0" },
  "dependencies": {
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "vite": "^6.3.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
