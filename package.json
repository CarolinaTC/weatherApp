    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --test src/services/*.test.js src/utils/*.test.js",
    "test:watch": "node --test --watch src/services/*.test.js src/utils/*.test.js"
